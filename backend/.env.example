# Here is an example env file, please create a .env file in ./backend directory.

# Server config
APP_NAME=MindBridge
HOST=127.0.0.1
PORT=8080
DEBUG=true

# LLM Provider
OPENAI_MODEL=gpt-5
GEMINI_MODEL=gemini-2.5-flash

# API KEY
OPENAI_API_KEY=YOUR_OpenAI_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Model Temperature
MODEL_TEMPERATURE=0.3

# RAG Settings
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=3

# Embedding: "local" (LM Studio/Ollama) or "gemini"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=http://localhost:1234/v1

# PostgreSQL / pgvector
DATABASE_URL=postgresql+psycopg://mindbridge:mindbridge_dev@localhost:5432/mindbridge
PGVECTOR_COLLECTION=mental_health_docs

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true

# Auth (JWT) — CHANGE SECRET_KEY IN PRODUCTION
SECRET_KEY=change-me-in-production-use-32-random-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=20

# Max user message length (chars)
MAX_MESSAGE_LENGTH=4000
