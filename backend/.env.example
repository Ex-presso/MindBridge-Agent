# Server config
HOST=127.0.0.1
PORT=8080
DEBUG=true

# NOTE: LLM API keys are managed per-user in the database.
# Users add their own keys via the Settings page in the frontend.
# System-level keys below are optional — only needed for the legacy /chat/completions endpoint.
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Default model names (used when no model specified in request)
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.5-flash
MODEL_TEMPERATURE=0.3

# RAG Settings
# chunk_size=2000 is the IR-benchmark winner (see docs/EVALUATION.md)
RAG_CHUNK_SIZE=2000
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=3

# Embedding: "sentence_transformers" (recommended), "local" (LM Studio/Ollama), or "gemini"
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_BASE_URL=http://localhost:1234/v1

# PostgreSQL / pgvector
DATABASE_URL=postgresql+psycopg://mindbridge:mindbridge_dev@localhost:5432/mindbridge
PGVECTOR_COLLECTION=mental_health_docs

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true

# Auth (JWT) — CHANGE SECRET_KEY IN PRODUCTION
SECRET_KEY=change-me-in-production-use-32-random-bytes
# Separate key for encrypting user API keys; falls back to SECRET_KEY if unset.
# ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set true in production behind HTTPS so the refresh cookie is Secure.
COOKIE_SECURE=false

# Rate limiting
RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT=5/minute
MAX_MESSAGE_LENGTH=4000

# Feature flags
# Legacy /chat/completions is unauthenticated + uses system keys — keep off
# unless a trusted local OpenAI-compatible client needs it.
ENABLE_LEGACY_CHAT_ENDPOINT=false
# Create tables on startup (dev). Set false in prod and run Alembic migrations.
AUTO_CREATE_TABLES=true

# LangSmith tracing (optional) — traces every agent run to https://smith.langchain.com
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=mindbridge
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
