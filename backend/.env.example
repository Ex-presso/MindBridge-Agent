# Server config
HOST=127.0.0.1
PORT=8080
DEBUG=true

# Default chat model. User API keys are managed per-user in Settings.
DEFAULT_LLM_MODEL=deepseek-v4-flash
DEFAULT_LLM_BASE_URL=https://api.deepseek.com
MODEL_TEMPERATURE=0.3

# Normal chat uses the encrypted per-user key saved in Settings. Evaluation
# runners read this optional local copy because they create disposable users.
# DEEPSEEK_API_KEY=

# RAG Settings
# Retrieval defaults; rerun the optional IR benchmark before tuning them.
RAG_CHUNK_SIZE=2000
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=3

# Long-term memory global kill switch. Per-user consent also defaults off.
MEMORY_ENABLED=false
# Read-only Selection budgets. Episode similarity uses the embedding config below.
MEMORY_SELECT_SEMANTIC_LIMIT=12
MEMORY_SELECT_EPISODE_TOP_K=3
# Conservative cosine-similarity floor; calibrate if the embedding model changes.
MEMORY_EPISODE_MIN_SCORE=0.55
MEMORY_SEMANTIC_ITEM_MAX_CHARS=280
MEMORY_EPISODE_SUMMARY_MAX_CHARS=800
MEMORY_EPISODE_TOPIC_MAX_CHARS=80
MEMORY_CONTEXT_MAX_CHARS=4000
MEMORY_EMBED_DIMS=1024
# Lightweight leased outbox worker; keep enabled so crisis deletions drain even
# while MEMORY_ENABLED=false.
MEMORY_WORKER_ENABLED=true
MEMORY_WORKER_POLL_SECONDS=1
MEMORY_WORKER_LEASE_SECONDS=90
MEMORY_WORKER_MAX_ATTEMPTS=3

# Embedding: "sentence_transformers" (recommended), "local" (LM Studio/Ollama)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_BASE_URL=http://localhost:1234/v1

# PostgreSQL / pgvector
DATABASE_URL=postgresql+psycopg://mindbridge:mindbridge_dev@localhost:5432/mindbridge
DATABASE_ISOLATION_LEVEL=READ COMMITTED
PGVECTOR_COLLECTION=mental_health_docs

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true

# Auth (JWT) — CHANGE SECRET_KEY IN PRODUCTION
SECRET_KEY=change-me-in-production-use-32-random-bytes
# Separate key for encrypting user API keys; falls back to SECRET_KEY if unset.
# ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set true in production behind HTTPS so the refresh cookie is Secure.
COOKIE_SECURE=false

# Rate limiting
RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT=5/minute
MAX_MESSAGE_LENGTH=4000

# Feature flags
# Legacy /chat/completions is unauthenticated + uses system keys — keep off
# unless a trusted local OpenAI-compatible client needs it.
ENABLE_LEGACY_CHAT_ENDPOINT=false
# Dev/Docker: adopt a recognized legacy create_all schema and run Alembic to head.
# In production, set false and run `uv run alembic upgrade head` before startup.
AUTO_CREATE_TABLES=true

# LangSmith tracing (optional) — traces every agent run to https://smith.langchain.com
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=mindbridge
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
